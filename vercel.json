{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/.well-known/jwks.json",
      "destination": "/api/jwks"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape-trends",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-briefs",
      "schedule": "0 23 * * 6"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/cron/discover-prospects",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/scrape-ticketing-platforms",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/composio-sync-engagement",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/composio-sync-insights",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/drive-reconcile",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/seo-publish-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/seo-rec-outcomes",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/seo-preview-jti-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/seo-rec-generate",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/seo-beacon-process",
      "schedule": "0 * * * *"
    }
  ]
}
